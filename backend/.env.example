# Copy to .env (or export in your shell). All optional in mock mode.

# Route LLM agent calls through OpenRouter (Claude models). Required only when
# config.yaml has llm.provider: openrouter.
OPENROUTER_API_KEY=

# Only if embeddings.backend: voyage in config.yaml
VOYAGE_API_KEY=

# Force a provider regardless of config.yaml (handy for CI / demos): mock | openrouter
# LLM_PROVIDER=mock
